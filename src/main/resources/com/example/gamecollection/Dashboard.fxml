<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1080.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.gamecollection.DashboardController">
   <top>
      <VBox spacing="10.0" BorderPane.alignment="CENTER_LEFT">
         <padding>
            <Insets bottom="24.0" left="56.0" right="56.0" top="44.0" />
         </padding>
         <children>
            <Label text="Game Collection">
               <font>
                  <Font size="46.0" />
               </font>
            </Label>
            <Label text="Pick a quick challenge and jump straight in." wrapText="true">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </top>
   <center>
      <TilePane hgap="24.0" prefColumns="2" vgap="24.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="24.0" left="56.0" right="56.0" top="8.0" />
         </padding>
         <children>
            <Button fx:id="tttBtn" mnemonicParsing="false" onAction="#launchTicTacToe" prefHeight="168.0" prefWidth="430.0" text="Tic Tac Toe&#10;Classic board duel" wrapText="true">
               <font>
                  <Font size="24.0" />
               </font>
            </Button>
            <Button fx:id="ngBtn" mnemonicParsing="false" onAction="#launchNumberGuess" prefHeight="168.0" prefWidth="430.0" text="Number Guess&#10;Beat the clock in 10 tries" wrapText="true">
               <font>
                  <Font size="24.0" />
               </font>
            </Button>
            <Button fx:id="rpsBtn" mnemonicParsing="false" onAction="#launchRockPaperScissors" prefHeight="168.0" prefWidth="430.0" text="Rock Paper Scissors&#10;Best of five against the CPU" wrapText="true">
               <font>
                  <Font size="24.0" />
               </font>
            </Button>
            <Button fx:id="reactionBtn" mnemonicParsing="false" onAction="#launchReactionTime" prefHeight="168.0" prefWidth="430.0" text="Reaction Time&#10;Tap the target as fast as you can" wrapText="true">
               <font>
                  <Font size="24.0" />
               </font>
            </Button>
         </children>
      </TilePane>
   </center>
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="12.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="40.0" left="56.0" right="56.0" top="8.0" />
         </padding>
         <children>
            <Label text="One window. Four games." />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="exitBtn" mnemonicParsing="false" onAction="#exitApp" text="Exit" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
