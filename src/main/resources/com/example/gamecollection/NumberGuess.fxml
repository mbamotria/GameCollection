<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="560.0" prefWidth="760.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.gamecollection.NumberGuess.NumberGuessController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="16.0">
         <padding>
            <Insets bottom="18.0" left="48.0" right="48.0" top="40.0" />
         </padding>
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label text="Number Guess">
                     <font>
                        <Font size="34.0" />
                     </font>
                  </Label>
                  <Label text="Find the secret number between 1 and 100.">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="exitBtn" mnemonicParsing="false" onAction="#handleExit" text="Exit" />
         </children>
      </HBox>
   </top>
   <center>
      <VBox alignment="CENTER" spacing="18.0">
         <padding>
            <Insets bottom="8.0" left="48.0" right="48.0" top="8.0" />
         </padding>
         <children>
            <Label fx:id="statusLabel" alignment="CENTER" text="Guess The Number">
               <font>
                  <Font size="26.0" />
               </font>
            </Label>
            <Label alignment="CENTER" text="You have 10 attempts to find the right number." />
            <HBox alignment="CENTER" spacing="12.0">
               <children>
                  <TextField fx:id="numberBox" prefHeight="42.0" prefWidth="220.0" promptText="Enter a number" />
                  <Button fx:id="guessBtn" mnemonicParsing="false" onAction="#handleGuess" text="Guess" />
               </children>
            </HBox>
            <Label fx:id="attemptsLabel" alignment="CENTER" text="Attempts: 0 / 10">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER" spacing="12.0">
         <padding>
            <Insets bottom="40.0" left="48.0" right="48.0" top="18.0" />
         </padding>
         <children>
            <Button fx:id="restartBtn" mnemonicParsing="false" onAction="#handleRestart" text="Restart" />
            <Button fx:id="homeBtn" mnemonicParsing="false" onAction="#handleHome" text="Home" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
