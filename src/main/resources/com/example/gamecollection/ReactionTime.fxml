<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="560.0" prefWidth="760.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.gamecollection.ReactionTimeController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="16.0">
         <padding>
            <Insets bottom="18.0" left="48.0" right="48.0" top="40.0" />
         </padding>
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label text="Reaction Time">
                     <font>
                        <Font size="34.0" />
                     </font>
                  </Label>
                  <Label text="Tap the target as fast as you can.">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="exitBtn" mnemonicParsing="false" onAction="#handleExit" text="Exit" />
         </children>
      </HBox>
   </top>
   <center>
      <VBox alignment="CENTER" spacing="18.0">
         <padding>
            <Insets bottom="8.0" left="48.0" right="48.0" top="8.0" />
         </padding>
         <children>
            <Label fx:id="statusLabel" alignment="CENTER" text="Press Start to begin.">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <Label fx:id="reactionLabel" alignment="CENTER" text="Last reaction: --">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <Label fx:id="bestLabel" text="Best: --">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <Label fx:id="roundsLabel" text="Rounds: 0">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <StackPane prefHeight="270.0" prefWidth="270.0">
               <children>
                  <Button fx:id="targetBtn" mnemonicParsing="false" onAction="#handleTarget" text="Click!" visible="false" managed="false" />
               </children>
            </StackPane>
            <Button fx:id="startBtn" mnemonicParsing="false" onAction="#handleStart" text="Start Round" />
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER" spacing="12.0">
         <padding>
            <Insets bottom="40.0" left="48.0" right="48.0" top="18.0" />
         </padding>
         <children>
            <Button fx:id="restartBtn" mnemonicParsing="false" onAction="#handleRestart" text="Reset" />
            <Button fx:id="homeBtn" mnemonicParsing="false" onAction="#handleHome" text="Home" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
