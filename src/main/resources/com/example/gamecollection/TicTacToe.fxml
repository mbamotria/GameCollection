<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="860.0" prefWidth="760.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.gamecollection.TicTacToe.TicTacToeController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="16.0">
         <padding>
            <Insets bottom="18.0" left="48.0" right="48.0" top="40.0" />
         </padding>
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label text="Tic Tac Toe">
                     <font>
                        <Font size="34.0" />
                     </font>
                  </Label>
                  <Label fx:id="statusLabel" text="Your turn (X)">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="exitBtn" mnemonicParsing="false" onAction="#handleExit" text="Exit" />
         </children>
      </HBox>
   </top>
   <center>
      <VBox alignment="CENTER" spacing="16.0">
         <padding>
            <Insets bottom="8.0" left="48.0" right="48.0" top="8.0" />
         </padding>
         <children>
            <Label alignment="CENTER" text="You play as X. The CPU plays O." />
            <GridPane alignment="CENTER" hgap="12.0" vgap="12.0">
               <children>
                  <Button fx:id="Btn00" mnemonicParsing="false" onAction="#handleEvent" />
                  <Button fx:id="Btn01" mnemonicParsing="false" onAction="#handleEvent" GridPane.columnIndex="1" />
                  <Button fx:id="Btn02" mnemonicParsing="false" onAction="#handleEvent" GridPane.columnIndex="2" />
                  <Button fx:id="Btn10" mnemonicParsing="false" onAction="#handleEvent" GridPane.rowIndex="1" />
                  <Button fx:id="Btn11" mnemonicParsing="false" onAction="#handleEvent" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Button fx:id="Btn12" mnemonicParsing="false" onAction="#handleEvent" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                  <Button fx:id="Btn20" mnemonicParsing="false" onAction="#handleEvent" GridPane.rowIndex="2" />
                  <Button fx:id="Btn21" mnemonicParsing="false" onAction="#handleEvent" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <Button fx:id="Btn22" mnemonicParsing="false" onAction="#handleEvent" GridPane.columnIndex="2" GridPane.rowIndex="2" />
               </children>
            </GridPane>
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER" spacing="12.0">
         <padding>
            <Insets bottom="40.0" left="48.0" right="48.0" top="18.0" />
         </padding>
         <children>
            <Button fx:id="saveBtn" mnemonicParsing="false" onAction="#handleSave" text="Save" />
            <Button fx:id="loadBtn" mnemonicParsing="false" onAction="#handleLoad" text="Load" />
            <Button fx:id="restartBtn" mnemonicParsing="false" onAction="#handleRestart" text="Restart" />
            <Button fx:id="homeBtn" mnemonicParsing="false" onAction="#handleHome" text="Home" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
